      "id": "ff1d213f-e12c-4ef1-9560-2858a42b5221",
      "name": "Read E1 Template",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -560,
        960
      ],
      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "0H8BF2AXEbHkp00R",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\n\n// Extract senderAccounts (3 email addresses) and per-account daily limit\nlet senderAccounts = config.senderAccounts;\nif (typeof senderAccounts === 'string') {\n  try {\n    senderAccounts = JSON.parse(senderAccounts);\n  } catch (e) {\n    senderAccounts = null;\n  }\n}\nif (!Array.isArray(senderAccounts) || senderAccounts.length === 0) {\n  senderAccounts = [\n    \"ceo@bminternational.com.pk\",\n    \"sales@bminternational.com.pk\",\n    \"info@bminternational.com.pk\"\n  ];\n}\n\nconst dailyLimitPerAccount = Number(config.dailyLimitPerAccount || config.dailyLimit) || 30;\nconst perRunBatchSize = Number(config.perRunBatchSize) || 15;\nconst minDelaySeconds = Number(config.minDelaySeconds) || 200;\nconst maxDelaySeconds = Number(config.maxDelaySeconds) || 280;\n\n// Read counter rows from Read Counter Row input for each account independently\nconst counterRows = $('Read Counter Row').all().map(item => item.json);\nconst todayStr = new Date().toISOString().substring(0, 10);\n\nconst accountSentCounts = {};\nsenderAccounts.forEach(account => {\n  const row = counterRows.find(r => r && r.dateKey === todayStr && r.emailAddress === account);\n  accountSentCounts[account] = row ? Number(row.sentCount) || 0 : 0;\n});\n\n// Parse templates (Only E1)\nconst e1Draft = $('Read E1 Template').first()?.json || {};\nconst hasE1 = Boolean(e1Draft.Subject && e1Draft.Body);\n\nif (!hasE1) {\n  return [];\n}\n\n// Read leads & filter\nconst leads = $('Read Leads').all().map(item => item.json);\nconst eligibleLeads = [];\nconst seenEmails = new Set();\n\nleads.forEach(lead => {\n  if (!lead || !lead.Emails) return;\n\n  const rawEmail = String(lead.Emails).trim();\n  if (!rawEmail) return;\n\n  const emailKey = rawEmail.toLowerCase();\n\n  // Case-insensitive deduplication using seenEmails set\n  if (seenEmails.has(emailKey)) return;\n\n  // Exclude leads where lead.Replied === 'Yes'\n  const replied = String(lead.Replied || '').trim().toLowerCase() === 'yes';\n  if (replied) return;\n\n  // Exclude leads where lead['E1 Status'] is already set and not 'Pending'\n  const e1Status = String(lead['E1 Status'] || '').trim();\n  const isPending = !e1Status || e1Status.toLowerCase() === 'pending';\n\n  if (isPending) {\n    seenEmails.add(emailKey);\n    eligibleLeads.push({\n      ...lead,\n      nextStage: 'E1'\n    });\n  }\n});\n\n// Round-robin rotation across the 3 sender accounts\nconst leadsToSend = [];\nlet currentAccountIndex = 0;\n\nfor (const lead of eligibleLeads) {\n  if (leadsToSend.length >= perRunBatchSize) {\n    break;\n  }\n\n  let selectedAccount = null;\n  let attempts = 0;\n\n  while (attempts < senderAccounts.length) {\n    const candidateAccount = senderAccounts[currentAccountIndex];\n    const currentSent = accountSentCounts[candidateAccount] || 0;\n\n    currentAccountIndex = (currentAccountIndex + 1) % senderAccounts.length;\n    attempts++;\n\n    if (currentSent < dailyLimitPerAccount) {\n      selectedAccount = candidateAccount;\n      break;\n    }\n  }\n\n  // If all 3 accounts reach 30 emails for the day (or hit a break), stop adding leads\n  if (!selectedAccount) {\n    break;\n  }\n\n  // Increment that account's accountSentCounts[account]\n  accountSentCounts[selectedAccount] = (accountSentCounts[selectedAccount] || 0) + 1;\n  const updatedSentCount = accountSentCounts[selectedAccount];\n\n  // Personalization (Only E1)\n  const leadName = lead['Lead Name'] ? String(lead['Lead Name']).trim() : '';\n  let subject = e1Draft.Subject;\n  let body = e1Draft.Body;\n\n  if (leadName) {\n    subject = subject.replace(/{Lead Name}/g, leadName);\n    body = body.replace(/{Lead Name}/g, leadName);\n  } else {\n    subject = subject.replace(/{Lead Name}/g, '').replace(/[ \\t]+/g, ' ').trim();\n    body = body.replace(/Hi {Lead Name}/gi, 'Hi')\n              .replace(/Hello {Lead Name}/gi, 'Hello')\n              .replace(/{Lead Name}/g, '')\n              .replace(/[ \\t]+/g, ' ');\n  }\n\n  // Calculate random delay or distribution spacing parameters (min 200s, max 280s) over 6-hour window\n  const sendTimeWindow = Math.floor(Math.random() * (maxDelaySeconds - minDelaySeconds + 1)) + minDelaySeconds;\n\n  leadsToSend.push({\n    json: {\n      Emails: lead.Emails,\n      LeadName: leadName,\n      nextStage: 'E1',\n      senderEmail: selectedAccount,\n      subject,\n      body,\n      sentCount: updatedSentCount,\n      sendTimeWindow\n    }\n  });\n}\n\nreturn leadsToSend;"
    },
