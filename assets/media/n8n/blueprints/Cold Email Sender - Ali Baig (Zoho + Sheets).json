    {
      "parameters": {
        "jsCode": "const config = $('Config').first().json;\nconst counterRow = $('Read Counter Row').first().json || {};\nconst sentToday = Number(counterRow.sentCount) || 0;\nconst dailyLimit = Number(config.dailyLimit) || 0;\nconst perRunBatchSize = Number(config.perRunBatchSize) || 0;\nconst remainingCapacity = Math.max(dailyLimit - sentToday, 0);\nconst effectiveLimit = Math.min(remainingCapacity, perRunBatchSize);\nreturn [{ json: { dailyLimit, perRunBatchSize, minDelaySeconds: Number(config.minDelaySeconds) || 60, maxDelaySeconds: Number(config.maxDelaySeconds) || 240, fromEmail: config.fromEmail, sentToday, remainingCapacity, effectiveLimit } }];"
      },
