        "mode": "runOnceForEachItem",
        "jsCode": "const capacity = $('Compute Send Capacity').first().json;\nconst min = Number(capacity.minDelaySeconds) || 60;\nconst max = Number(capacity.maxDelaySeconds) || 240;\nconst waitSeconds = Math.floor(Math.random() * (max - min + 1)) + min;\nreturn { json: { ...$json, waitSeconds } };"
      },
